# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Everything is optional: without these the app runs fully with sample data, an offline
# FinPilot, and progress saved in the browser tab.

# --- Google Gemini: FinPilot answers + reading uploaded W-2s (server only, never exposed)
GEMINI_API_KEY=
# Model for every AI path (web + iMessage advisor, agents, W-2 reading). Read at runtime.
# If unset or invalid, the fallback in src/lib/server/geminiModel.mjs is used (gemini-3.5-flash).
# In Vercel, set it for EVERY environment you use (Production and Preview), then redeploy.
GEMINI_MODEL=
# Set to true if your key is a Vertex AI express-mode key (AQ.… from Google Cloud console).
# Leave unset for AI Studio keys. Check: open /api/health?check=gemini
GEMINI_USE_VERTEX=

# --- Supabase: sign-in + saving Tax Assistant and Academy progress across devices
# Installing the Supabase integration on Vercel sets these for you.
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects: publishable key (sb_publishable_...). Older projects: use the anon key instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put a service-role / secret key in a NEXT_PUBLIC_ variable.

# --- Supabase server access (SERVER ONLY): persistent banking storage for My Budget/FinPilot.
# Without these, banking records live in one server instance's memory (lost between
# serverless invocations). Vercel's Supabase integration sets them. Never NEXT_PUBLIC_.
SUPABASE_URL=
# Service-role key (legacy) or the new secret key (sb_secret_...). Not the publishable/anon key.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# Force the in-memory store (tests/local only): BANKING_STORE=memory

# --- Capital One Nessie v2 sandbox (simulated demo banking data for My Budget, Credit and
# FinPilot; server only). Key (nsk_...) from https://v2-prod-api.nessieisreal.com/account.
# Sent only as "Authorization: Bearer <key>". Without it, My Budget uses a clearly labelled
# fictional fallback. An empty sandbox shows "no accounts yet" (no fictional data).
# FirstFunds only READS the sandbox: it never seeds data or moves money.
NESSIE_API_KEY=
# Optional. Default: https://v2-prod-api.nessieisreal.com (do not use the retired v1 hosts)
NESSIE_BASE_URL=
# Optional: only import accounts for one customer (otherwise GET /accounts for this key)
NESSIE_CUSTOMER_ID=
# Optional request timeout in ms (default 8000)
# NESSIE_TIMEOUT_MS=

# --- Deep Agents (FinPilot deep mode / Agent Console)
# With GEMINI_API_KEY set, agents run on Gemini. Force the deterministic mock model with:
# AGENT_MODE=mock
# Encrypts private agent memory at rest (32 bytes, base64): openssl rand -base64 32
MEMORY_ENCRYPTION_KEY=
# Encrypts secure links sent by text (any long random string)
SECURE_LINK_SECRET=
# Public base URL used in secure links (defaults to the Vercel URL or localhost)
APP_URL=

# --- Photon 2.0 Beta (iMessage). All three set = LIVE mode, otherwise MOCK mode.
# Server-side only: never prefix these with NEXT_PUBLIC_.
# Project ID: Photon Beta dashboard (app.beta.photon.codes) → Settings
PHOTON_PROJECT_ID=
# Project API key (pho_sk_...): project sidebar → API keys → New API key,
# permissions project:read + project:write. Shown once.
PHOTON_API_KEY=
# Signing secret (whsec_...) of the webhook destination pointing at
# https://<your-domain>/api/photon/webhook, subscribed to message.received.
PHOTON_WEBHOOK_SECRET=
# Optional: API origin override (defaults to https://api.photon.codes)
# PHOTON_API_URL=
# Phone numbers (or Apple ID emails) that are linked to the SYNTHETIC demo taxpayer for
# judging/demos, separated by commas. Any format works ("+1 (609) 555-0123", "6095550123",
# "+44 20 7946 0958"); 10-digit numbers are treated as US. Each one must ALSO have a Photon
# shared-line assignment, or its texts never reach the app. Redeploy after changing it.
# Anyone can ask general questions without this.
# PHOTON_DEMO_NUMBERS=
# Mock-mode signing secret (local testing only; any string or a whsec_ value)
# PHOTON_MOCK_WEBHOOK_SECRET=
# Allow the demo driver endpoints in live mode (default: mock mode only)
# ENABLE_AGENT_DEMO=1
